; Personal identity (user.name/email) lives in ~/.gitconfig.local, which is
; sourced via the [include] line at the bottom of this file and is NOT
; tracked in the dotfiles repo. See README.md.

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.gitattributes
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	trustctime = false
	precomposeunicode = false
	untrackedCache = true
	# Use delta as pager when available; falls back to less otherwise.
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = ansi

[apply]
	whitespace = fix

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red
	new = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[column]
	ui = auto

[commit]
	; Uncomment if your gpg/ssh signing is set up.
	; gpgsign = true

[diff]
	algorithm = histogram
	colorMoved = default
	renames = copies

[diff "bin"]
	textconv = hexdump -v -C

[fetch]
	prune = true
	pruneTags = true
	all = true

[help]
	autocorrect = prompt

[merge]
	conflictStyle = zdiff3
	log = true

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true
	autoUpdate = true

[status]
	showUntrackedFiles = all

[url "git@github.com:"]
	insteadOf = "gh:"
	pushInsteadOf = "github:"
	pushInsteadOf = "git://github.com/"

[url "git://github.com/"]
	insteadOf = "github:"

[url "git@gist.github.com:"]
	insteadOf = "gst:"
	pushInsteadOf = "gist:"
	pushInsteadOf = "git://gist.github.com/"

[url "git://gist.github.com/"]
	insteadOf = "gist:"

[alias]
	# Status / log.
	s = status -sb
	l = log --pretty=oneline -n 20 --graph --abbrev-commit
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(cyan)%an%Creset %s %C(green)(%cr)%Creset %C(magenta)%d%Creset' --all
	last = log -1 HEAD --stat

	# Branching.
	co = checkout
	cob = checkout -b
	br = branch
	# Switch to a branch, creating it if necessary.
	go = "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"

	# Diff.
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"
	di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"
	ds = diff --staged

	# Commit.
	ca = !git add -A && git commit -av
	amend = commit --amend --reuse-message=HEAD
	amendf = commit --amend --no-edit
	wip = !git add -A && git commit -m 'wip' --no-verify
	undo = reset --soft HEAD~1

	# Sync.
	p = pull --recurse-submodules
	c = clone --recursive

	# Discovery.
	tags = tag -l
	branches = branch --all
	remotes = remote --verbose
	aliases = config --get-regexp alias
	contributors = shortlog --summary --numbered

	# Find.
	fb = "!f() { git branch -a --contains $1; }; f"
	ft = "!f() { git describe --always --contains $1; }; f"
	fc = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"
	fm = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"

	# Maintenance.
	# Delete branches that have been merged into the current branch.
	dm = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"
	# Prune branches whose upstream is gone.
	prune-gone = "!git fetch --prune && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D"

	# Retag.
	retag = "!r() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; r"

	# Interactive rebase last N commits.
	reb = "!r() { git rebase -i HEAD~$1; }; r"

	whoami = config user.email

; Per-machine identity, signing keys, and any private config.
; This file is NOT tracked; copy gitconfig.local.example into place.
[include]
	path = ~/.gitconfig.local

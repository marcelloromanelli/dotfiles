# This file is installed as ~/.gitignore (global gitignore).
# It also serves as the repo's gitignore for the dotfiles repo itself.

# macOS metadata.
.DS_Store
.AppleDouble
.LSOverride
._*
Icon?
.Spotlight-V100
.Trashes

# Windows metadata.
Desktop.ini
Thumbs.db

# Editor / IDE.
.idea/
.vscode/
*.swp
*.swo
*~

# Compiled / packaged.
*.pyc
__pycache__/
node_modules/
.venv/
.env

# Direnv.
.envrc

# Local override files (consumed by install.sh, never tracked).
.gitconfig.local
.extra

# Work-specific Brewfile (uses private SSH-only tap).
Brewfile.work

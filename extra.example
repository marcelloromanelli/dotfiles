#!/usr/bin/env zsh
# ~/.extra — local, untracked, sourced from ~/.zshrc.
# Edit this file with your actual values. It's gitignored.
#
# Common uses:
#   - Work env vars (databricks, mlflow, internal tokens)
#   - Secrets (API keys, when not loaded from 1Password)
#   - Machine-specific overrides

# =============================================================================
# Example: work env vars
# =============================================================================
# export MLFLOW_TRACKING_URI=databricks
# export DATABRICKS_HOST=https://your-org.cloud.databricks.com/


# Ghostty config — https://ghostty.org/docs/config
# Run `ghostty +show-config --default --docs` to see every option with docs.
# Reload after editing: ⌘⇧, in Ghostty, or just quit + reopen.

# -----------------------------------------------------------------------------
# Font
# -----------------------------------------------------------------------------
font-family = "MesloLGS Nerd Font Mono"
font-size = 14

# -----------------------------------------------------------------------------
# Theme — Ghostty ships dozens. Browse with: ghostty +list-themes
# A few good ones to try:
#   "Catppuccin Mocha"     — popular dark, pastel accents
#   "Tokyo Night"          — dark, cool blues/purples
#   "GruvboxDarkHard"      — warm, high-contrast retro
#   "Dracula"              — classic purple/pink dark
#   "Solarized Dark"       — eye-friendly muted dark
# -----------------------------------------------------------------------------
theme = "Catppuccin Mocha"

# -----------------------------------------------------------------------------
# Window / chrome
# -----------------------------------------------------------------------------
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-save-state = always

macos-titlebar-style = transparent

# ⎇ acts as Meta (needed for many zsh keybinds)
macos-option-as-alt = true

# Dock icon variant. Valid values: official, blueprint, chalkboard, microchip,
# glass, holographic, paper, retro, xray, custom, custom-style
macos-icon = holographic

# -----------------------------------------------------------------------------
# Cursor
# -----------------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false
# Cursor uses the text's color; text under cursor takes the bg color → "invert" look
cursor-color = cell-foreground
cursor-text = cell-background
shell-integration-features = cursor,sudo,title

# -----------------------------------------------------------------------------
# UX
# -----------------------------------------------------------------------------
# don't ask "really close?" on every tab/window
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
scrollback-limit = 100000

# New tabs/windows open in the current tab's working directory (saves a cd)
window-inherit-working-directory = true
# Trim trailing whitespace/newlines on paste (prevents accidental command execution)
clipboard-trim-trailing-spaces = true
# Richer colors on modern Apple Silicon Macs (M1+, 2018+ MBP)
window-colorspace = display-p3

# Tiny background blur (looks nice on macOS, set to 0 if you hate it)
background-opacity = 0.97
background-blur-radius = 20

# -----------------------------------------------------------------------------
# Keybinds (a few quality-of-life additions)
# -----------------------------------------------------------------------------
# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# Quick reset
keybind = cmd+k=clear_screen

# -----------------------------------------------------------------------------
# Quick Terminal — system-wide dropdown
# -----------------------------------------------------------------------------
# ⌃⌥⌘C — the "Meh" modifier chord (Ctrl+Option+Cmd) + C. One-handed: hit the
# three modifiers with the left thumb/palm (they're in a row on the bottom-
# left of the keyboard) and tap C with the left index finger. From ANY app
# it drops down a terminal from the top of the screen. Press it again to
# hide. Virtually no macOS or third-party app uses ⌃⌥⌘ by default, so this
# combo is in your private namespace.
#
# Cmd is part of the combo on purpose: ctrl/alt-based hotkeys get delivered
# to the terminal's stdin AS WELL AS triggering the toggle, which causes
# kitty-keyboard-protocol escape sequences like `\e[96;5u` to leak into the
# prompt as visible garbage. Cmd is consumed by the app and never reaches
# the terminal, so there's nothing to leak.
#
# First use will prompt for Accessibility permission in System Settings →
# Privacy & Security → Accessibility. Tick Ghostty.
keybind = global:cmd+ctrl+alt+c=toggle_quick_terminal

# Quick Terminal behavior. See `ghostty +show-config --default --docs` for
# all options (autohide, layer, animation, screen, etc.)
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true

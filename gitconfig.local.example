; ~/.gitconfig.local — personal identity, untracked.
; Copy into place: `cp gitconfig.local.example ~/.gitconfig.local` and edit.

[user]
	name = Your Name
	email = you@example.com
	; Use ssh-key signing (modern, simpler than GPG).
	; signingkey = ~/.ssh/id_ed25519.pub

[gpg]
	; format = ssh

[commit]
	; gpgsign = true

; Use a different identity inside a particular directory tree.
; Example: at work, override the email below.
;
; [includeIf "gitdir:~/work/"]
;	path = ~/.gitconfig.work
